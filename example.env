# Discord bot token used for publishing, match embeds and voice channel names (required)
DISCORD_BOT_TOKEN=

# PSN NPSSO cookie used to resolve PSN usernames into profile pictures (required)
PSN_NPSSO=

# Discord webhook living in the player activity channel (required)
DISCORD_WEBHOOK_URL=

# Shared secret the Cloudflare Worker sends as the x-webhook-secret header (required)
WEBHOOK_SECRET=

# Cloudflare API token with Workers KV read access, used for the "Total PS3 Users" channel (optional)
CLOUDFLARE_API_TOKEN=

# Optional overrides
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_PROFILES_NAMESPACE_ID=
# WEBHOOK_PORT=4321
# PUBLIC_BASE_URL=https://bot.example.com